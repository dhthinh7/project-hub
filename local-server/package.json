{
  "name": "project-manager-local-server",
  "version": "1.0.0",
  "description": "Local server for opening projects",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "build:exe": "pkg . --targets node18-win-x64 --output server.exe",
    "build:all": "pkg . --targets node18-win-x64,node18-macos-x64,node18-linux-x64"
  },
  "pkg": {
    "assets": [],
    "outputPath": "dist"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  }
}
